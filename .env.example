# Sistema de Escala RH — modelo de variáveis de ambiente.
# Copie para .env (chmod 600) e preencha. Gere segredos com: openssl rand -hex 32
# Use senhas só com [A-Za-z0-9] (vão dentro de URLs de conexão) e sem aspas.

TZ=America/Sao_Paulo
DOMAIN=escala.seudominio.com.br

# Postgres — superusuário: SÓ para backup/restore/admin (nenhum serviço usa)
POSTGRES_USER=
POSTGRES_PASSWORD=
# Roles sem superusuário (criadas pelo init em volume novo ou por ./scripts/db-roles.sh)
#   escala_app    -> base `escala` (app/worker/migrations)
#   evolution_app -> base `evolution`, schema `evolution_api` (Evolution API)
APP_DB_PASSWORD=
EVOLUTION_DB_PASSWORD=
# Mesma senha de APP_DB_PASSWORD:
APP_DB_URL=postgresql://escala_app:<APP_DB_PASSWORD>@postgres:5432/escala?schema=public

# Redis (requirepass; usado pela Evolution)
REDIS_PASSWORD=

# App
JWT_SECRET=
# Só o seed usa (scripts/deploy.sh repassa ao `docker compose run ... seed.js`);
# NÃO vão para o ambiente do app/worker.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Evolution API (somente rede interna)
EVOLUTION_API_KEY=
EVOLUTION_URL=http://evolution:8080
EVOLUTION_INSTANCE=escala
WEBHOOK_TOKEN=
